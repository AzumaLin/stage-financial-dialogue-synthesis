{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage dialogue",
  "type": "object",
  "required": ["dialogue_id", "method", "client_name", "adviser_name", "turns"],
  "properties": {
    "dialogue_id": {"type": "string", "pattern": "^stage_[0-9]{3}$"},
    "method": {"const": "Stage"},
    "client_name": {"type": "string"},
    "adviser_name": {"type": "string"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_index", "stage"],
        "properties": {
          "stage_index": {"type": "integer", "minimum": 1},
          "stage": {"type": "string"},
          "applied_max_turns": {"type": "integer", "minimum": 1},
          "stopping_reason": {
            "type": "string",
            "enum": ["success_signal", "end", "repetition", "max_turn"]
          },
          "success_achieved": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn_id", "stage_index", "stage", "speaker", "text"],
        "properties": {
          "turn_id": {"type": "integer", "minimum": 0},
          "stage_index": {"type": "integer", "minimum": 1},
          "stage": {"type": "string"},
          "speaker": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
